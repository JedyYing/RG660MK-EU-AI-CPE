[Unit]
Description=RG660MK LuCI local URL 18081 -> 192.168.1.1:80 (LAN)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/socat TCP-LISTEN:18081,bind=127.0.0.1,fork,reuseaddr TCP:192.168.1.1:80
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
