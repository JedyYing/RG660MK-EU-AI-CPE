#!/bin/sh /etc/rc.common
# ai-net-manager (Phase 1 Shadow) procd service
START=98
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /bin/sh -c "cd /data/ai_cpe/ai_net && exec /usr/bin/python3 -u -m ai_net.service --config config/main.json --log logs/service.log"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
