#!/bin/sh /etc/rc.common
# radiodiag —— RG660MK 5G 网络实时诊断与小区自愈（watch 常驻 · 自动自愈=开）
# 2026-09-29 部署：60s 巡检；异常经复核后射频软循环触发重新选网并验证
START=96
STOP=08
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/python3 -u /data/ai_cpe/radiodiag.py watch --interval 60 --apply --net
	# 自动自愈阈值（偏保守，防误触发；单位见 radiodiag.py 文档）
	procd_set_param env RSRP_WEAK=-97 RSRP_SEVERE=-107 LOSS_PCT=40 RTT_MS=250 JITTER_MS=120 HEAL_COOLDOWN=300
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
