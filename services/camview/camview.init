#!/bin/sh /etc/rc.common
# RG660MK 摄像头网页预览服务 (libuvc 用户态直采)
# 开机自启;程序体放在持久分区 /data/camview/

START=95
STOP=10
USE_PROCD=1

PROG=/data/camview/camview
PORT=8090

start_service() {
	[ -x "$PROG" ] || return 1
	procd_open_instance
	procd_set_param command "$PROG" --port "$PORT"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	:
}
