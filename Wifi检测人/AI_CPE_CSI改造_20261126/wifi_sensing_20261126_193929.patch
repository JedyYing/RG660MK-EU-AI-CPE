@@ -0,0 +1,293 @@
+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""bk_state — BK7236 CSI 状态机的 Python 移植（参考 Wifi检测人/BK7236）
+
+Beken 的 `armino_main.c` 不直接算 CSI；固件算法事件给出
+`move_change_rate` / `state_change_rate`，应用层再按阈值做“无人 / 有人 /
+静态变化”状态机。本模块在 MT7992 原始 CSI 上计算两个等价特征：
+
+    move_rate  = 相邻两个唯一 CSI 帧的归一化幅度平均差 × 100
+    state_rate = 当前帧相对静默基线的归一化幅度平均差 × 100
+
+然后用 BK7236 的状态机逻辑（连续 N 次、阈值、空态确认）输出状态。
+这不是把 Beken 的闭源 DSP 搬过来，而是把可复用的状态机和参数语义落到
+我们的原始 CSI 数据上；算法差异见 docs/wifi_sensing 对照报告。
+
+作者: hermes  2026-11-26
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass, asdict
+from typing import Any, Iterable
+
+
+def normalize_amp(amp: Iterable[float]) -> list[float]:
+    """按帧均值归一化，去掉 RSSI/AGC 的整体缩放，只保留 CFR 形状。"""
+    vals = [float(x) for x in amp]
+    if not vals:
+        return []
+    m = sum(vals) / len(vals)
+    if m <= 1e-9:
+        return [0.0] * len(vals)
+    return [x / m for x in vals]
+
+
+def mean_abs_diff(left: Iterable[float], right: Iterable[float]) -> float:
+    a, b = list(left), list(right)
+    if not a or not b or len(a) != len(b):
+        return 0.0
+    return sum(abs(x - y) for x, y in zip(a, b)) / len(a)
+
+
+@dataclass
+class BKConfig:
+    """BK7236 CSI demo 的默认参数（可从 BLE/JSON 覆盖）。"""
+
+    thres1: float = 5.0       # 动态变化阈值（move_change_rate）
+    thres2: float = 3.0       # 状态变化阈值（state_change_rate）
+    thres3: float = 8.0       # 静态变化判定阈值
+    thres4: float = 8.0       # 运动中重新配置的阈值（保留兼容）
+    rate1: int = 8
+    rate2: int = 16
+    rate3: int = 8
+    static_update: int = 15000
+    calibration_cnt: int = 200
+    hold_time: int = 0
+    motion_consecutive: int = 4       # BK: motion_cnt >= 4 才判有人
+    empty_consecutive: int = 4        # 无人连续确认
+    static_detection: int = 100       # BK: 100 个算法事件
+    static_detection_threshold: int = 50
+
+    @classmethod
+    def from_dict(cls, data: dict[str, Any] | None) -> "BKConfig":
+        if not data:
+            return cls()
+        fields = cls.__dataclass_fields__
+        kwargs = {}
+        for key, value in data.items():
+            if key in fields and value is not None:
+                try:
+                    kwargs[key] = type(getattr(cls(), key))(value)
+                except (TypeError, ValueError):
+                    pass
+        return cls(**kwargs)
+
+
+class BKStateMachine:
+    """BK7236 风格的状态机；输入 normalized amplitude 帧，输出状态和特征。
+
+    `push` 返回一个 dict，既用于在线 daemon，也用于离线评估，避免两套算法：
+        {
+          "move_rate": float, "state_rate": float,
+          "state": "no_motion"|"motion",
+          "state_static": "empty"|"change",
+          "present": bool, "changed": bool, "event": dict|None
+        }
+    重复 pkt_sn（固件重臂回放）会被跳过，避免把同一 PPDU 当作运动。
+    """
+
+    def __init__(self, config: BKConfig | None = None, baseline: list[float] | None = None):
+        self.cfg = config or BKConfig()
+        self.state = "no_motion"
+        self.state_static = "empty"
+        self.present = False
+        self.move_rate = 0.0
+        self.state_rate = 0.0
+        self.motion_count = 0
+        self.empty_count = 0
+        self.static_count = 0
+        self.prev_amp: list[float] | None = None
+        self.prev_sn: Any = None
+        self.prev_ts: float | None = None
+        self.baseline = list(baseline) if baseline else None
+        self.calibrating = False
+        self.calib_target = 0
+        self._calib_sum: list[float] = []
+        self._calib_n = 0
+        self.events: list[dict[str, Any]] = []
+        self._event_open: dict[str, Any] | None = None
+        self.frames_seen = 0
+        self.frames_used = 0
+
+    # ---- 校准 ---------------------------------------------------------
+    def start_calibration(self, frames: int | None = None) -> None:
+        self.calibrating = True
+        self.calib_target = int(frames or self.cfg.calibration_cnt)
+        self._calib_sum = []
+        self._calib_n = 0
+        self.state = "no_motion"
+        self.present = False
+        self.motion_count = 0
+        self.empty_count = 0
+
+    def finish_calibration(self) -> list[float] | None:
+        if self._calib_n <= 0:
+            self.calibrating = False
+            return None
+        self.baseline = [x / self._calib_n for x in self._calib_sum]
+        self.calibrating = False
+        self.calib_target = self._calib_n
+        return self.baseline
+
+    def _calibration_add(self, amp: list[float]) -> bool:
+        if not self._calib_sum:
+            self._calib_sum = [0.0] * len(amp)
+        if len(amp) != len(self._calib_sum):
+            return False
+        for i, value in enumerate(amp):
+            self._calib_sum[i] += value
+        self._calib_n += 1
+        if self._calib_n >= self.calib_target:
+            self.finish_calibration()
+        return True
+
+    # ---- 主入口 -------------------------------------------------------
+    def push(self, frame: dict[str, Any]) -> dict[str, Any]:
+        amp = frame.get("amp")
+        if not amp:
+            return self.snapshot(changed=False)
+        self.frames_seen += 1
+        na = normalize_amp(amp)
+        if not na:
+            return self.snapshot(changed=False)
+
+        # 只对连续重复 pkt_sn 去重；不按全局集合去重，避免序号回绕误删新帧。
+        sn = frame.get("pkt_sn")
+        ts = float(frame.get("host_ts") or frame.get("ts") or 0.0)
+        if sn is not None and sn == self.prev_sn and self.prev_ts is not None and ts - self.prev_ts < 1.0:
+            return self.snapshot(changed=False)
+
+        if self.calibrating:
+            self._calibration_add(na)
+            self.prev_amp = na
+            self.prev_sn = sn
+            self.prev_ts = ts
+            return self.snapshot(changed=False)
+
+        move = mean_abs_diff(self.prev_amp, na) * 100.0 if self.prev_amp else 0.0
+        state_rate = mean_abs_diff(self.baseline, na) * 100.0 if self.baseline else 0.0
+        self.move_rate = round(move, 4)
+        self.state_rate = round(state_rate, 4)
+        self.prev_amp = na
+        self.prev_sn = sn
+        self.prev_ts = ts
+        self.frames_used += 1
+        event = self._update_state()
+        return self.snapshot(changed=True, event=event)
+
+    def _update_state(self) -> dict[str, Any] | None:
+        cfg = self.cfg
+        event = None
+        if self.state == "no_motion":
+            if self.move_rate > cfg.thres1:
+                self.motion_count += 1
+            else:
+                self.motion_count = 0
+            if self.motion_count >= cfg.motion_consecutive:
+                self.state = "motion"
+                self.present = True
+                self.empty_count = 0
+                self.motion_count = 0
+                self._event_open = {
+                    "type": "motion_start",
+                    "ts": self.prev_ts or 0.0,
+                    "move_rate": self.move_rate,
+                }
+                self.events.append(self._event_open)
+                event = self._event_open
+            # 静态环境变化：相对基线持续偏离；只记录，不冒充人体运动。
+            if self.state_rate > cfg.thres3:
+                self.static_count += 1
+            else:
+                self.static_count = 0
+            if self.static_count >= cfg.static_detection_threshold:
+                self.state_static = "change"
+        else:  # motion
+            if self.move_rate > cfg.thres1:
+                self.empty_count = 0
+                self.state = "motion"
+            else:
+                self.empty_count += 1
+                if self.empty_count >= cfg.empty_consecutive:
+                    self.state = "no_motion"
+                    self.present = False
+                    self.empty_count = 0
+                    start = (self._event_open or {}).get("ts", self.prev_ts or 0.0)
+                    ev = {
+                        "type": "motion_end",
+                        "ts": self.prev_ts or 0.0,
+                        "duration": round(max(0.0, (self.prev_ts or 0.0) - start), 1),
+                        "move_rate": self.move_rate,
+                    }
+                    self.events.append(ev)
+                    self._event_open = None
+                    event = ev
+        return event
+
+    def snapshot(self, changed: bool = True, event: dict[str, Any] | None = None) -> dict[str, Any]:
+        return {
+            "move_rate": self.move_rate,
+            "state_rate": self.state_rate,
+            "state": self.state,
+            "state_static": self.state_static,
+            "present": self.present,
+            "changed": bool(changed),
+            "frames_seen": self.frames_seen,
+            "frames_used": self.frames_used,
+            "motion_count": self.motion_count,
+            "empty_count": self.empty_count,
+            "static_count": self.static_count,
+            "threshold": self.cfg.thres1,
+            "thresholds": asdict(self.cfg),
+            "baseline": self.baseline,
+            "event": event,
+        }
+
+    # ---- 离线便捷入口 -------------------------------------------------
+    def feed(self, frames: Iterable[dict[str, Any]], calibrate_first: int = 0) -> list[dict[str, Any]]:
+        rows = []
+        if calibrate_first:
+            self.start_calibration(calibrate_first)
+        for frame in frames:
+            rows.append(self.push(frame))
+        return rows
+
+
+class BKDetector:
+    """给 csi_daemon 使用的最小适配器，保持原 MotionDetector 的字段接口。"""
+
+    algorithm = "bk"
+
+    def __init__(self, config: BKConfig | None = None, baseline: list[float] | None = None,
+                 threshold: float | None = None):
+        if threshold is not None:
+            cfg = config or BKConfig()
+            cfg.thres1 = float(threshold)
+            config = cfg
+        self.machine = BKStateMachine(config=config, baseline=baseline)
+        self.last_score = 0.0
+        self.last_diff = 0.0
+        self.present = False
+        self.last_active_at = 0.0
+        self.threshold = self.machine.cfg.thres1
+        self.baseline = baseline
+        self.events = self.machine.events
+
+    @property
+    def state(self) -> str:
+        return self.machine.state
+
+    def push(self, frame: dict[str, Any]) -> float | None:
+        result = self.machine.push(frame)
+        self.last_score = float(result.get("move_rate") or 0.0)
+        self.last_diff = float(result.get("state_rate") or 0.0)
+        self.present = bool(result.get("present"))
+        if self.present:
+            self.last_active_at = float(frame.get("host_ts") or frame.get("ts") or 0.0)
+        self.baseline = self.machine.baseline
+        return self.last_score
+
+    def calibrate(self, duration: float = 20.0) -> dict[str, Any] | None:
+        # daemon 的 /api/calibrate 已按时间采集；这里只返回当前状态
+        return {"baseline": self.machine.baseline, "duration": duration,
+                "samples": self.machine._calib_n}
