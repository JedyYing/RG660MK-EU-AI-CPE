@@ -0,0 +1,170 @@
+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""analyze_bk — 用 BK7236 风格状态机离线评估 MT7992 CSI 录制
+
+用法:
+  python3 analyze_bk.py --rec data/samples/sample_2g_walk_152405.jsonl.gz \
+      --motion-start 30 --motion-end 60 --pre-end 30 --out data/eval_bk.json
+
+输入支持 .jsonl 和 .jsonl.gz；按 pkt_sn 去重；以前 200 个唯一 pre 帧做静默基线。
+输出与 analyze_motion.py 的 legacy 结果分开，便于做改造前后对照。
+"""
+from __future__ import annotations
+
+import argparse
+import gzip
+import json
+import os
+import statistics
+from dataclasses import asdict, dataclass
+from typing import Any
+
+from bk_state import BKConfig, BKStateMachine, normalize_amp
+
+
+def load(path: str) -> list[dict[str, Any]]:
+    opener = gzip.open if path.endswith(".gz") else open
+    rows = []
+    with opener(path, "rt", encoding="utf-8") as f:
+        for line in f:
+            line = line.strip()
+            if not line:
+                continue
+            try:
+                r = json.loads(line)
+            except json.JSONDecodeError:
+                continue
+            if r.get("amp"):
+                rows.append(r)
+    rows.sort(key=lambda r: float(r.get("t_rel", r.get("ts", 0))))
+    return rows
+
+
+def pct(values: list[float], q: float) -> float | None:
+    if not values:
+        return None
+    s = sorted(values)
+    idx = max(0, min(len(s) - 1, int(round((q / 100.0) * (len(s) - 1)))))
+    return round(float(s[idx]), 4)
+
+
+def _dedup_frames(rows: list[dict[str, Any]]) -> list[dict[str, Any]]:
+    out = []
+    last_sn = object()
+    for r in rows:
+        sn = r.get("pkt_sn")
+        if sn == last_sn:
+            continue
+        last_sn = sn
+        out.append(r)
+    return out
+
+
+def _pre_noise_p95(rows: list[dict[str, Any]]) -> float | None:
+    vals = []
+    prev = None
+    for r in _dedup_frames(rows):
+        amp = normalize_amp(r.get("amp") or [])
+        if not amp:
+            continue
+        if prev is not None:
+            vals.append(sum(abs(a - b) for a, b in zip(amp, prev)) / len(amp) * 100.0)
+        prev = amp
+    return pct(vals, 95)
+
+
+def evaluate(rows: list[dict[str, Any]], motion_start: float, motion_end: float,
+             pre_end: float, cfg: BKConfig | None = None) -> dict[str, Any]:
+    cell = (cfg or BKConfig())
+    # BK 的默认阈值 5 是它自己的特征量纲；MT7992 的 move_rate 约 10–60，
+    # 必须用静默段 p95 校准，不能照搬 5。
+    pre_frames = [r for r in rows if float(r.get("t_rel", r.get("ts", 0))) < pre_end]
+    noise_p95 = _pre_noise_p95(pre_frames)
+    calibrated_thres1 = max(cell.thres1, round((noise_p95 or 0.0) * 1.5, 4))
+    cell.thres1 = calibrated_thres1
+    machine = BKStateMachine(config=cell)
+    # 1) 静默基线：前 200 个唯一帧（只吃 pre 段）
+    machine.start_calibration(cell.calibration_cnt)
+    for r in pre_frames:
+        machine.push(r)
+    baseline = machine.finish_calibration()
+    # 2) 全量回放；重置状态但保留基线
+    machine.state = "no_motion"
+    machine.present = False
+    machine.motion_count = 0
+    machine.empty_count = 0
+    machine.prev_amp = None
+    machine.prev_sn = None
+    machine.prev_ts = None
+    timeline = []
+    for r in rows:
+        t = float(r.get("t_rel", r.get("ts", 0)))
+        res = machine.push(r)
+        if res.get("changed"):
+            timeline.append({"t": round(t, 3), **{k: res.get(k) for k in
+                             ("move_rate", "state_rate", "state", "present")}})
+    pre = [x for x in timeline if x["t"] < motion_start]
+    motion = [x for x in timeline if motion_start <= x["t"] <= motion_end]
+    post = [x for x in timeline if x["t"] > motion_end]
+    pre_move = [x["move_rate"] for x in pre]
+    mot_move = [x["move_rate"] for x in motion]
+    pre_state = [x["state_rate"] for x in pre]
+    mot_state = [x["state_rate"] for x in motion]
+    # 检出：状态为 motion 或 move_rate 超过阈值；报告两者，避免口径混淆
+    det_state = [bool(x["present"]) for x in motion]
+    det_rate = [bool(x["move_rate"] > (cfg or BKConfig()).thres1) for x in motion]
+    first = next((x["t"] - motion_start for x in motion if x["present"]), None)
+    return {
+        "algorithm": "bk7236-inspired",
+        "config": asdict(cell),
+        "calibrated_threshold": cell.thres1,
+        "baseline_frames": len(pre_frames),
+        "baseline_ready": bool(baseline),
+        "frames_total": len(rows),
+        "frames_used": machine.frames_used,
+        "unique_or_used_ratio": round(machine.frames_used / max(1, len(rows)), 3),
+        "segments": {"pre": len(pre), "motion": len(motion), "post": len(post)},
+        "move_rate": {
+            "pre": {"p50": pct(pre_move, 50), "p95": pct(pre_move, 95)},
+            "motion": {"p50": pct(mot_move, 50), "p95": pct(mot_move, 95)},
+        },
+        "state_rate": {
+            "pre": {"p50": pct(pre_state, 50), "p95": pct(pre_state, 95)},
+            "motion": {"p50": pct(mot_state, 50), "p95": pct(mot_state, 95)},
+        },
+        "detect_ratio_state": round(sum(det_state) / len(det_state), 4) if det_state else None,
+        "detect_ratio_rate": round(sum(det_rate) / len(det_rate), 4) if det_rate else None,
+        "pre_fp_ratio_state": round(sum(bool(x["present"]) for x in pre) / len(pre), 4) if pre else None,
+        "first_detect_latency_s": round(first, 2) if first is not None else None,
+        "state_events": machine.events[-20:],
+        "note": "state detection requires 4 consecutive move_rate > calibrated threshold; threshold = max(BK default, pre p95 x 1.5)",
+    }
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--rec", required=True, help="jsonl 或 jsonl.gz")
+    ap.add_argument("--motion-start", type=float, default=30.0)
+    ap.add_argument("--motion-end", type=float, default=60.0)
+    ap.add_argument("--pre-end", type=float, default=30.0)
+    ap.add_argument("--thres1", type=float, default=5.0)
+    ap.add_argument("--motion-consecutive", type=int, default=4)
+    ap.add_argument("--out", default="")
+    args = ap.parse_args()
+    cfg = BKConfig(thres1=args.thres1, motion_consecutive=args.motion_consecutive)
+    rows = load(args.rec)
+    if not rows:
+        print(json.dumps({"ok": False, "msg": "no amp frames"}, ensure_ascii=False))
+        return 1
+    out = evaluate(rows, args.motion_start, args.motion_end, args.pre_end, cfg)
+    out["ok"] = True
+    out["rec"] = os.path.abspath(args.rec)
+    print(json.dumps(out, ensure_ascii=False, indent=1))
+    if args.out:
+        with open(args.out, "w", encoding="utf-8") as f:
+            json.dump(out, f, ensure_ascii=False, indent=1)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
