+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""最小回归：验证 BK7236 风格状态机的“连续 4 次才 motion”与退出。"""
+import os
+import sys
+
+sys.path.insert(0, "/data/ai_cpe/csi_sensing")
+from bk_state import BKConfig, BKStateMachine
+
+
+def frame(i, delta=0.0, sn=None):
+    amp = [10.0 + delta, 9.0, 8.0]
+    return {"amp": amp, "pkt_sn": sn if sn is not None else i, "host_ts": float(i)}
+
+
+def main():
+    cfg = BKConfig(thres1=1.0, motion_consecutive=4, empty_consecutive=4)
+    m = BKStateMachine(cfg)
+    # 基线 8 帧
+    m.start_calibration(8)
+    for i in range(8):
+        m.push(frame(i))
+    assert m.baseline is not None, "baseline missing"
+    # 连续 3 帧变化不应触发（每帧形状都变化，模拟真实运动）
+    for i in range(3):
+        m.push(frame(10 + i, delta=10.0 + (i % 2)))
+    assert not m.present, "motion should require 4 consecutive frames"
+    # 第 4 帧触发
+    m.push(frame(14, delta=11.0))
+    assert m.present, "motion should start after 4 consecutive frames"
+    # 连续 5 帧稳定后退出（第 1 帧先结束最后一次变化）
+    for i in range(5):
+        m.push(frame(20 + i, delta=0.0))
+    assert not m.present, "motion should end after 4 empty frames"
+    print("BK_STATE_TEST=PASS")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
